<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="22sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/botonConectar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conectar" />

        <TextView
            android:id="@+id/textoEstado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Desconectado"
            android:textSize="14sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/textoAyuda"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:text="Prendé el robot y tocá Conectar."
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/panelConectado"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Una sola línea: si creciera a dos, el renglón cambiaría de alto según el
                 nombre del modo y los botones bailarían cada vez que tocás un valor. -->
            <Button
                android:id="@+id/botonModo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Personalizado"
                android:textAllCaps="false"
                android:textSize="13sp" />

            <Button
                android:id="@+id/botonGuardarModo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Guardar modo"
                android:textAllCaps="false"
                android:textSize="13sp" />

        </LinearLayout>

        <ScrollView
            android:id="@+id/scrollParametros"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/contenedorParametros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>

        <Button
            android:id="@+id/botonGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grabar en el robot" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/botonStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Arrancar" />

            <Button
                android:id="@+id/botonStop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Parar" />

        </LinearLayout>

        <!-- El alto real lo pone el código con el que dejó el usuario la última vez;
             se cambia arrastrando la barra de arriba. -->
        <LinearLayout
            android:id="@+id/panelHistorial"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/fondo_terminal"
            android:orientation="vertical"
            android:padding="1dp">

            <LinearLayout
                android:id="@+id/barraHistorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/barra_terminal"
                android:orientation="vertical"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp">

                <View
                    android:layout_width="36dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/agarradera" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="historial"
                        android:textColor="@color/terminal_evento"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:text="tocá una línea para volver"
                        android:textColor="@color/terminal_hora"
                        android:textSize="11sp" />

                    <!-- Chico y gris: borra todo, así que no tiene que llamar la atención. -->
                    <TextView
                        android:id="@+id/botonLimpiarHistorial"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/toque_terminal"
                        android:fontFamily="monospace"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="4dp"
                        android:text="limpiar"
                        android:textColor="@color/terminal_evento"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

            <ScrollView
                android:id="@+id/scrollHistorial"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/lineasHistorial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp" />

            </ScrollView>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
