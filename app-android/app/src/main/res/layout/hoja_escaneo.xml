<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/hoja"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="13dp"
        android:background="@drawable/agarradera" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="3dp"
        android:fontFamily="@font/raleway_extrabold"
        android:text="Elegí el módulo del robot"
        android:textColor="@color/tinta"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:fontFamily="@font/jetbrains_mono_medium"
        android:text="ordenado por potencia de señal"
        android:textColor="@color/tinta2"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/listaHallazgos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/espacio_8"
        android:orientation="vertical"
        android:showDividers="middle" />

    <TextView
        android:id="@+id/cancelarEscaneo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/boton_contorno"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/raleway_bold"
        android:gravity="center"
        android:padding="12dp"
        android:text="Cancelar"
        android:textColor="@color/tinta2"
        android:textSize="12.5sp" />

</LinearLayout>
