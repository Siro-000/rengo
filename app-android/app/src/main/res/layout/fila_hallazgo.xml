<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/hallazgo"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="11dp">

    <!-- Tres barritas de señal que se pintan según el RSSI. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <View
            android:id="@+id/barrita1"
            android:layout_width="3dp"
            android:layout_height="6dp"
            android:background="@drawable/barrita" />

        <View
            android:id="@+id/barrita2"
            android:layout_width="3dp"
            android:layout_height="11dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/barrita" />

        <View
            android:id="@+id/barrita3"
            android:layout_width="3dp"
            android:layout_height="16dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/barrita" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/nombreHallazgo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/raleway_bold"
            android:maxLines="1"
            android:textColor="@color/tinta"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/detalleHallazgo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/jetbrains_mono_medium"
            android:maxLines="1"
            android:textColor="@color/tinta2"
            android:textSize="10sp" />

    </LinearLayout>

</LinearLayout>
