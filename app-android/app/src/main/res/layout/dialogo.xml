<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="24dp">

    <LinearLayout
        android:id="@+id/tarjetaDialogo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/fondo_dialogo"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/tituloDialogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/raleway_extrabold"
            android:textColor="@color/tinta"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/mensajeDialogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lato_regular"
            android:lineSpacingMultiplier="1.25"
            android:textColor="@color/tinta2"
            android:textSize="12.5sp" />

        <LinearLayout
            android:id="@+id/detalleDialogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/detalle_dialogo"
            android:divider="@drawable/espacio_5"
            android:orientation="vertical"
            android:paddingHorizontal="11dp"
            android:paddingVertical="10dp"
            android:showDividers="middle"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cancelarDialogo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/boton_contorno"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/raleway_bold"
                android:gravity="center"
                android:padding="12dp"
                android:text="Cancelar"
                android:textColor="@color/tinta2"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/accionDialogo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/raleway_bold"
                android:gravity="center"
                android:padding="12dp"
                android:textSize="12.5sp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
