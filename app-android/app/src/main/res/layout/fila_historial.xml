<?xml version="1.0" encoding="utf-8"?>
<!-- El margen negativo compensa el padding: el texto queda alineado con el resto de las
     líneas y el resaltado de las tocables sobresale un poco a los costados. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="-6dp"
    android:orientation="horizontal"
    android:paddingHorizontal="6dp"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/horaLinea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/jetbrains_mono_regular"
        android:lineSpacingMultiplier="1.1"
        android:textColor="@color/terminal_hora"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/cuerpoLinea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_weight="1"
        android:fontFamily="@font/jetbrains_mono_regular"
        android:lineSpacingMultiplier="1.1"
        android:textSize="11sp" />

</LinearLayout>
