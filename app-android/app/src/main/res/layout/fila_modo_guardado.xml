<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/nombreModoGuardado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingVertical="16dp"
        android:textSize="16sp" />

    <!-- Sin marco y en gris: tiene que estar a mano, pero el nombre es la acción
         principal y un botón entero al lado lo tapaba. -->
    <Button
        android:id="@+id/botonBorrarModo"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="Borrar modo"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="✕"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="16sp" />

</LinearLayout>
