<?xml version="1.0" encoding="utf-8"?>
<!-- Android 7 no entiende los íconos adaptables: ahí va el círculo armado a mano. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="18dp"
        android:left="18dp"
        android:right="18dp"
        android:top="18dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/marca" />
            <corners android:radius="36dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_letra" />
</layer-list>
